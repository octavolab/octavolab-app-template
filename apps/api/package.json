{
  "name": "api",
  "private": true,
  "version": "0.7.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env --conditions=development src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --coverage",
    "test:int": "vitest run test/integration --coverage.enabled=false",
    "dev:worker": "tsx watch --env-file=../../.env --conditions=development src/workers/outbox.worker.ts",
    "worker": "node dist/workers/outbox.worker.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^12.0.1",
    "@fastify/rate-limit": "^10.1.1",
    "@fastify/swagger": "^9.2.0",
    "@octavolab/db": "workspace:*",
    "@octavolab/integrations": "workspace:*",
    "argon2": "^0.41.1",
    "bullmq": "^5.16.0",
    "fastify": "^5.0.0",
    "fastify-type-provider-zod": "^4.0.2",
    "ioredis": "^5.4.1",
    "pino": "^9.4.0",
    "zod": "^3.23.8",
    "@fastify/static": "^8.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@vitest/coverage-v8": "^2.1.2",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.2"
  }
}
