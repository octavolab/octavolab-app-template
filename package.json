{
  "name": "octavolab-app-template",
  "private": true,
  "version": "0.7.1",
  "packageManager": "pnpm@10.34.7",
  "scripts": {
    "dev": "pnpm --filter \"./packages/**\" build && concurrently -n api,web \"pnpm --filter api dev\" \"pnpm --filter web dev\"",
    "build": "pnpm --filter \"./packages/**\" build && pnpm --filter api --filter web build",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "e2e": "playwright test",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm e2e && pnpm security",
    "security": "gitleaks detect --no-git -v && semgrep --config p/owasp-top-ten --error .",
    "db:migrate": "pnpm --filter @octavolab/db migrate",
    "db:seed": "pnpm --filter @octavolab/db seed",
    "db:generate": "pnpm --filter @octavolab/db generate",
    "licenses": "pnpm licenses list --json"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "concurrently": "^9.0.1",
    "eslint": "^9.12.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "vitest": "^2.1.2",
    "@axe-core/playwright": "^4.10.0"
  },
  "type": "module"
}
