{
  "openapi": "3.0.3",
  "info": {
    "title": "OctavoLab app template API",
    "version": "1.0.0"
  },
  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "sid"
      }
    },
    "schemas": {}
  },
  "paths": {
    "/api/health": {
      "get": {
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/api/client-config": {
      "get": {
        "summary": "Public runtime configuration for the web app (Sentry DSN, environment, release)",
        "tags": [
          "config"
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/api/v1/auth/2fa/enroll": {
      "post": {
        "summary": "Start TOTP enrollment: returns the otpauth URI and secret once",
        "tags": [
          "auth",
          "2fa"
        ],
        "description": "Staff and owner only. Restarting before activation replaces the pending secret. 409 if 2FA is already enabled. Response is Cache-Control: no-store.",
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/api/v1/auth/2fa/activate": {
      "post": {
        "summary": "Activate TOTP with a code from the authenticator; returns 10 single-use recovery codes once",
        "tags": [
          "auth",
          "2fa"
        ],
        "description": "Revokes the user's other sessions and re-issues the caller's cookie. 422 MFA_INVALID_CODE on a wrong code (rate-limited, audited).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string",
                    "pattern": "^\\d{6}$"
                  }
                },
                "required": [
                  "code"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/api/v1/auth/2fa/disable": {
      "post": {
        "summary": "Disable 2FA with the password and a code or recovery code",
        "tags": [
          "auth",
          "2fa"
        ],
        "description": "409 MFA_REQUIRED for owners and admins while REQUIRE_PRIVILEGED_2FA=true. Revokes the user's other sessions.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "password": {
                    "type": "string",
                    "minLength": 8,
                    "maxLength": 200
                  },
                  "code": {
                    "type": "string",
                    "pattern": "^\\d{6}$"
                  },
                  "recoveryCode": {
                    "type": "string",
                    "minLength": 10,
                    "maxLength": 24,
                    "pattern": "^[A-Za-z0-9 -]+$"
                  }
                },
                "required": [
                  "password"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/api/v1/auth/2fa/recovery-codes": {
      "post": {
        "summary": "Replace the recovery codes (old ones stop working); confirm with a TOTP code",
        "tags": [
          "auth",
          "2fa"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string",
                    "pattern": "^\\d{6}$"
                  }
                },
                "required": [
                  "code"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/api/v1/users/{id}/2fa/reset": {
      "post": {
        "summary": "Owner: reset another user's 2FA in the owner's tenant (lost device); audited, revokes their sessions",
        "tags": [
          "users",
          "2fa"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "in": "path",
            "name": "id",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email",
                    "maxLength": 254
                  },
                  "password": {
                    "type": "string",
                    "minLength": 8,
                    "maxLength": 200
                  }
                },
                "required": [
                  "email",
                  "password"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/api/v1/auth/login/mfa": {
      "post": {
        "summary": "Second login step: TOTP code or recovery code after a correct password",
        "tags": [
          "auth"
        ],
        "description": "Requires the httpOnly mfa cookie set by POST /auth/login when it answered { mfaRequired: true } (valid 5 minutes). Send exactly one of code (6 digits) or recoveryCode. Rate-limited per user (5 per 5 minutes per IP, 20 per day). A recovery code works once.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string",
                    "pattern": "^\\d{6}$"
                  },
                  "recoveryCode": {
                    "type": "string",
                    "minLength": 10,
                    "maxLength": 24,
                    "pattern": "^[A-Za-z0-9 -]+$"
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "tags": [
          "auth"
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "tags": [
          "auth"
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/api/v1/orders": {
      "post": {
        "tags": [
          "orders"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "customerEmail": {
                    "type": "string",
                    "format": "email"
                  },
                  "currency": {
                    "type": "string",
                    "enum": [
                      "USD",
                      "GBP",
                      "EUR",
                      "COP",
                      "MXN",
                      "BRL"
                    ]
                  },
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "sku": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 64
                        },
                        "qty": {
                          "type": "integer",
                          "exclusiveMinimum": true,
                          "minimum": 0,
                          "maximum": 10000
                        },
                        "unitAmount": {
                          "type": "integer",
                          "minimum": 0
                        }
                      },
                      "required": [
                        "sku",
                        "qty",
                        "unitAmount"
                      ],
                      "additionalProperties": false
                    },
                    "minItems": 1,
                    "maxItems": 200
                  }
                },
                "required": [
                  "customerEmail",
                  "currency",
                  "items"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            },
            "in": "header",
            "name": "idempotency-key",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/api/v1/orders/{id}": {
      "get": {
        "tags": [
          "orders"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "in": "path",
            "name": "id",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/api/v1/orders/{id}/checkout": {
      "post": {
        "summary": "Start payment: draft or confirmed -> pending_payment and a provider payment intent",
        "tags": [
          "orders",
          "payments"
        ],
        "description": "Idempotent: the same Idempotency-Key replays the result (422 if reused for another request); an order already in pending_payment returns its existing intent. The signed payments webhook moves the order to paid. Amounts are integers in minor units with an ISO 4217 currency.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "in": "path",
            "name": "id",
            "required": true
          },
          {
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            },
            "in": "header",
            "name": "idempotency-key",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "orderId": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "pending_payment"
                      ]
                    },
                    "paymentIntentId": {
                      "type": "string"
                    },
                    "amount": {
                      "type": "integer"
                    },
                    "currency": {
                      "type": "string",
                      "minLength": 3,
                      "maxLength": 3
                    },
                    "clientSecret": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "orderId",
                    "status",
                    "paymentIntentId",
                    "amount",
                    "currency"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/users/{id}/role": {
      "patch": {
        "tags": [
          "users"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "role": {
                    "type": "string",
                    "enum": [
                      "owner",
                      "admin",
                      "operations",
                      "customer"
                    ]
                  }
                },
                "required": [
                  "role"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "in": "path",
            "name": "id",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/api/v1/me/orders": {
      "post": {
        "summary": "Customer: create a draft order for myself, priced from the tenant's products",
        "tags": [
          "me",
          "orders"
        ],
        "description": "Send SKUs and quantities only. Unit amounts and currency come from the tenant's active products (422 UNKNOWN_SKU, MIXED_CURRENCY, DUPLICATE_SKU). The order belongs to the caller (customerEmail is the account email). Idempotent: the Idempotency-Key is scoped to the caller and bound to the body (422 IDEMPOTENCY_MISMATCH on reuse with another body).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "sku": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 64
                        },
                        "qty": {
                          "type": "integer",
                          "exclusiveMinimum": true,
                          "minimum": 0,
                          "maximum": 1000
                        }
                      },
                      "required": [
                        "sku",
                        "qty"
                      ],
                      "additionalProperties": false
                    },
                    "minItems": 1,
                    "maxItems": 50
                  }
                },
                "required": [
                  "items"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            },
            "in": "header",
            "name": "idempotency-key",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      },
      "get": {
        "summary": "Customer: list my orders, newest first",
        "tags": [
          "me",
          "orders"
        ],
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            },
            "in": "query",
            "name": "limit",
            "required": false
          },
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "in": "query",
            "name": "cursor",
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/api/v1/me/orders/{id}": {
      "get": {
        "summary": "Customer: read one of my orders",
        "tags": [
          "me",
          "orders"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "in": "path",
            "name": "id",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/api/v1/me/orders/{id}/checkout": {
      "post": {
        "summary": "Customer: start payment for my order (draft -> pending_payment and a provider payment intent)",
        "tags": [
          "me",
          "orders",
          "payments"
        ],
        "description": "Same state machine, provider idempotency key (checkout:<orderId>) and transaction as staff checkout. Only the caller's own orders (404 otherwise). Idempotent: same key replays; a new key on an order already in pending_payment resumes its intent.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "in": "path",
            "name": "id",
            "required": true
          },
          {
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            },
            "in": "header",
            "name": "idempotency-key",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "orderId": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "pending_payment"
                      ]
                    },
                    "paymentIntentId": {
                      "type": "string"
                    },
                    "amount": {
                      "type": "integer"
                    },
                    "currency": {
                      "type": "string",
                      "minLength": 3,
                      "maxLength": 3
                    },
                    "clientSecret": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "orderId",
                    "status",
                    "paymentIntentId",
                    "amount",
                    "currency"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/products": {
      "get": {
        "summary": "List the tenant's products (staff also see inactive ones)",
        "tags": [
          "products"
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/api/v1/products/{sku}": {
      "put": {
        "summary": "Create or update a product by SKU (owner, admin); audited",
        "tags": [
          "products"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "unitAmount": {
                    "type": "integer",
                    "exclusiveMinimum": true,
                    "minimum": 0,
                    "maximum": 2147483647
                  },
                  "currency": {
                    "type": "string",
                    "enum": [
                      "USD",
                      "GBP",
                      "EUR",
                      "COP",
                      "MXN",
                      "BRL"
                    ]
                  },
                  "active": {
                    "type": "boolean",
                    "default": true
                  }
                },
                "required": [
                  "name",
                  "unitAmount",
                  "currency"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[\\w.-]+$"
            },
            "in": "path",
            "name": "sku",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/api/v1/webhooks/payments": {
      "post": {
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    }
  }
}
