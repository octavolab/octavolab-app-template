{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadOnlyDiscovery",
      "Effect": "Allow",
      "Action": [
        "lightsail:GetContainerServices",
        "lightsail:GetContainerServiceDeployments",
        "lightsail:GetContainerImages",
        "lightsail:GetContainerLog",
        "lightsail:GetContainerServiceMetricData",
        "lightsail:GetContainerAPIMetadata",
        "lightsail:GetRelationalDatabase",
        "lightsail:GetRelationalDatabaseSnapshots"
      ],
      "Resource": "*"
    },
    {
      "Sid": "RegistryLoginForImagePush",
      "Effect": "Allow",
      "Action": [
        "lightsail:CreateContainerServiceRegistryLogin"
      ],
      "Resource": "*"
    },
    {
      "Sid": "WriteOnlyProjectTaggedResources",
      "Effect": "Allow",
      "Action": [
        "lightsail:RegisterContainerImage",
        "lightsail:CreateContainerServiceDeployment",
        "lightsail:CreateRelationalDatabaseSnapshot"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/project": "${PROJECT_NAME}"
        }
      }
    },
    {
      "Sid": "ProjectSecrets",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:GetSecretValue",
        "secretsmanager:DescribeSecret",
        "secretsmanager:CreateSecret",
        "secretsmanager:TagResource"
      ],
      "Resource": "arn:aws:secretsmanager:*:*:secret:${PROJECT_NAME}/${ENV_NAME}-*"
    },
    {
      "Sid": "DenyDestructive",
      "Effect": "Deny",
      "Action": [
        "lightsail:DeleteContainerService",
        "lightsail:DeleteRelationalDatabase",
        "lightsail:DeleteBucket",
        "lightsail:DeleteContainerImage",
        "lightsail:DeleteRelationalDatabaseSnapshot"
      ],
      "Resource": "*"
    }
  ]
}
