# Copy to .env for local development (`cp .env.example .env`). The API dev script loads it with `--env-file=../../.env`
# and the db scripts with dotenv-cli. Production values live in Lightsail environment variables, never here.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://app:app@localhost:5432/app
REDIS_URL=redis://localhost:6379  # optional: rate-limit counters in Redis; unset = process memory (single API instance only)
RATE_LIMIT_MAX=100                # global requests per minute per client IP
SESSION_SECRET=change-me-32-chars-minimum-random
SEED_ADMIN_PASSWORD=change-me-local-only
SEED_CUSTOMER_PASSWORD=change-me-local-only   # optional: creates customer@example.com for self-service and E2E
# 2FA (TOTP) for staff and owner: 32 random bytes in base64 (`openssl rand -base64 32`). Without it 2FA endpoints answer 503.
TOTP_ENC_KEY=
REQUIRE_PRIVILEGED_2FA=false           # true in staging and production (infra/lightsail.json sets it); needs TOTP_ENC_KEY
TOTP_ISSUER=OctavoLab             # name shown in authenticator apps
# ALERT_WEBHOOK_URL=https://hooks.example.com/...   # required when INTEGRATIONS_MODE=live; secret (runbook "Alerts")
MFA_FAILED_ALERT_THRESHOLD=10     # failed 2FA codes in 15 min (all users) that fire an alert
APP_URL=http://localhost:5173
OPS_EMAIL=ops@example.com         # recipient of operational notifications from the outbox worker
API_URL=http://localhost:3000
INTEGRATIONS_MODE=fake            # fake | sandbox | live (required explicitly when NODE_ENV=production; live only with Jaime's approval)
PAYMENTS_PROVIDER=fake            # fake | stripe | wompi | payu | mercadopago
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CARRIER_PROVIDER=fake             # fake | oes
OES_API_KEY=
MESSAGING_PROVIDER=fake           # fake | resend | ses | twilio
RESEND_API_KEY=                   # re_...; required when MESSAGING_PROVIDER=resend and INTEGRATIONS_MODE is sandbox or live
MESSAGING_FROM=                   # "OctavoLab <noreply@your-verified-domain>"; same rule. Sandbox mode sends only to delivered@resend.dev
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
SENTRY_DSN=
# First access to a fresh environment (staging): creates the first owner if this email does not exist yet. Never overwrites a user.
# Set both in the Lightsail console (typed by a human), sign in once, enroll 2FA, then delete both variables.
BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_OWNER_PASSWORD=
