# Copy to .env for local development (`cp .env.example .env`). The API dev script loads it with `--env-file=../../.env`
# and the db scripts with dotenv-cli. Production values live in Lightsail environment variables, never here.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://app:app@localhost:5432/app
REDIS_URL=redis://localhost:6379  # optional: rate-limit counters in Redis; unset = process memory (single API instance only)
RATE_LIMIT_MAX=100                # global requests per minute per client IP
SESSION_SECRET=change-me-32-chars-minimum-random
SEED_ADMIN_PASSWORD=change-me-local-only
SEED_CUSTOMER_PASSWORD=change-me-local-only   # optional: creates customer@example.com for self-service and E2E
# 2FA (TOTP) for staff and owner: 32 random bytes in base64 (`openssl rand -base64 32`). Without it 2FA endpoints answer 503.
TOTP_ENC_KEY=
REQUIRE_PRIVILEGED_2FA=false           # true in staging and production (infra/lightsail.json sets it); needs TOTP_ENC_KEY
TOTP_ISSUER=OctavoLab             # name shown in authenticator apps
APP_URL=http://localhost:5173
OPS_EMAIL=ops@example.com         # recipient of operational notifications from the outbox worker
API_URL=http://localhost:3000
APP_ENV=local                     # local | test | staging | production; deploy.sh sets staging/production (Sentry environment, staging defaults)
# Integration modes (ADR 0005): fake | sandbox | live. Each per-integration mode defaults to INTEGRATIONS_MODE, then to fake.
# In NODE_ENV=production every mode must resolve explicitly. live needs ALLOW_LIVE=true (production only, Jaime's approval).
INTEGRATIONS_MODE=fake            # default for the four modes below
PAYMENTS_MODE=                    # empty = INTEGRATIONS_MODE; sandbox = Stripe test mode
MESSAGING_MODE=                   # empty = INTEGRATIONS_MODE; sandbox = Resend, test inbox + MESSAGING_ALLOW_LIST only
CARRIER_MODE=                     # empty = INTEGRATIONS_MODE; keep fake until the OES spec is implemented
STORAGE_MODE=                     # empty = INTEGRATIONS_MODE; sandbox = staging Lightsail bucket
ALLOW_LIVE=                       # never set locally or on staging; "true" only in production after Jaime's approval (N07)
PAYMENTS_PROVIDER=fake            # fake | stripe | wompi | payu | mercadopago (only stripe has an adapter)
STRIPE_SECRET_KEY=                # sk_test_/rk_test_ in sandbox, sk_live_/rk_live_ in live (restricted key preferred)
STRIPE_WEBHOOK_SECRET=            # whsec_... of the webhook endpoint for this environment (docs/integrations/stripe.md)
CARRIER_PROVIDER=fake             # fake | oes
OES_API_URL=                      # https base URL of the OES API for this environment (sandbox on staging)
OES_API_KEY=                      # OES API key for that environment
OES_QUOTE_PATH=                   # quote endpoint path from the OES spec (pending, see docs/integrations/oes.md)
MESSAGING_PROVIDER=fake           # fake | resend | ses | twilio (only resend has an adapter)
RESEND_API_KEY=                   # re_...; required when MESSAGING_MODE is sandbox or live
MESSAGING_FROM=                   # "Name <noreply@verified-domain>"; on APP_ENV=staging defaults to "OctavoLab Staging <noreply@24hcargo.com>"
MESSAGING_ALLOW_LIST=             # sandbox only: comma-separated addresses that receive real test emails (else delivered@resend.dev)
STORAGE_PROVIDER=fake             # fake | s3 (Lightsail bucket, S3 API)
S3_ENDPOINT=                      # https://s3.eu-west-2.amazonaws.com for a Lightsail bucket in eu-west-2
S3_BUCKET=                        # bucket name, e.g. octavolab-staging-files
S3_ACCESS_KEY=                    # Lightsail bucket access key id (scoped to one bucket; not an IAM user)
S3_SECRET_KEY=                    # its secret; shown once by create-bucket-access-key
S3_REGION=eu-west-2               # bucket region
SENTRY_DSN=                       # backend Sentry DSN; empty = Sentry disabled (API, worker and web)
SENTRY_WEB_DSN=                   # browser project DSN (public); empty = SENTRY_DSN
SENTRY_TRACES_SAMPLE_RATE=        # 0..1; empty = 0.1 (staging/local) or 0.05 (production)
